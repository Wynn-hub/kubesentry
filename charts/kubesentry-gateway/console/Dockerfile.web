# Build context is the repo root:
#   docker build -f charts/kubesentry-gateway/console/Dockerfile.web -t <tag> .
FROM node:20-alpine AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY charts/kubesentry-gateway/console/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
